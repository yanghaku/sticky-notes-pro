import { Palette } from "std-widgets.slint";

export global AppAppearance {
    // 0 follows the live system preference; 1/2 override it for every component.
    in-out property <int> mode-index: 0;
    // Native note frames are managed by Windows, not the editable color palette.
    in-out property <bool> native-note-frame: false;
    // UI typography is independent from the rasterized note body typography.
    in-out property <string> font-family: "";
    in-out property <float> font-size: 14;
    in-out property <int> scale-percent: 100;
    out property <float> ui-scale: min(250, max(50, scale-percent)) / 100.0;
    out property <float> font-scale: min(24, max(10, font-size)) / 14;
    // SlintInternal is unavailable to applications. Palette's effective base
    // surface follows the system live even when color-scheme is `unknown`.
    out property <bool> dark: mode-index == 2 || (mode-index == 0 && Palette.background.to-oklch().lightness < 0.5);
    out property <color> foreground: dark ? #e8eaed : #343b46;
    out property <color> muted-foreground: dark ? #aab0bb : #68717e;
    out property <color> status-foreground: dark ? #e8eaed66 : #343b4666;
    out property <color> surface: dark ? #27292d : #ffffff;
    out property <color> window-background: dark ? #202124 : #faf9f6;
    out property <color> border: dark ? #4a4e57 : #d9dce2;
    // Stable semantic order: yellow, green, pink, purple, blue, gray.
    in-out property <[color]> light-note-colors: [#fff4bf, #daf2ce, #fbd8e2, #e8ddfa, #d5ebfb, #e9e7e3];
    in-out property <[color]> dark-note-colors: [#3a3323, #27392c, #3e2932, #352e43, #253742, #343638];
    in-out property <color> light-note-border: #8b929e;
    in-out property <color> dark-note-border: #747c88;
    out property <color> note-window-border: dark ? dark-note-border : light-note-border;
    out property <color> hover: dark ? #ffffff14 : #343b4610;
    out property <color> active: dark ? #344a68 : #dbe9ff;
    out property <color> danger-foreground: dark ? #ffc1b8 : #a32620;
    out property <color> danger-background: dark ? #432a2a : #fff0ed;
    out property <color> danger-hover: dark ? #603432 : #ffd8d3;
    callback apply-mode(int);
    apply-mode(index) => {
        AppAppearance.mode-index = min(2, max(0, index));
        Palette.color-scheme = AppAppearance.mode-index == 1 ? ColorScheme.light : AppAppearance.mode-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    public pure function note-color(id: string) -> color {
        if AppAppearance.dark {
            return id == "yellow" ? AppAppearance.dark-note-colors[0] : id == "green" ? AppAppearance.dark-note-colors[1] : id == "pink" ? AppAppearance.dark-note-colors[2] : id == "purple" ? AppAppearance.dark-note-colors[3] : id == "blue" ? AppAppearance.dark-note-colors[4] : id == "gray" ? AppAppearance.dark-note-colors[5] : #202124;
        }
        return id == "yellow" ? AppAppearance.light-note-colors[0] : id == "green" ? AppAppearance.light-note-colors[1] : id == "pink" ? AppAppearance.light-note-colors[2] : id == "purple" ? AppAppearance.light-note-colors[3] : id == "blue" ? AppAppearance.light-note-colors[4] : id == "gray" ? AppAppearance.light-note-colors[5] : #ffffff;
    }
}

export struct NoteCard {
    id: string,
    theme-id: string,
    preview: string,
    created-at: string,
    updated-at: string,
    status: string,
    busy: bool,
}

export struct ShortcutEntry {
    label: string,
    keys: string,
    section: bool,
}

export struct ColorSlot {
    name: string,
    value: color,
    hex: string,
}
