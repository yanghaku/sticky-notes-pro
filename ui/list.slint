import { Button, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { AppAppearance, NoteCard } from "appearance.slint";
import { ColoredAction, DeleteButton, ViewTab } from "controls.slint";

export component NotesListWindow inherits Window {
    default-font-family: AppAppearance.font-family;
    default-font-size: (14px * AppAppearance.ui-scale) * AppAppearance.font-scale;
    title: (root.deleted-view ? "已删除便签" : "便签列表") + " · Sticky Notes Pro";
    icon: @image-url("../asserts/icon.png");
    preferred-width: (620px * AppAppearance.ui-scale);
    preferred-height: (520px * AppAppearance.ui-scale);
    min-width: 280px;
    min-height: 200px;
    background: AppAppearance.window-background;
    in-out property <[NoteCard]> cards;
    in-out property <bool> deleted-view: false;
    in-out property <string> error;
    callback new-note;
    callback settings;
    callback change-view(bool);
    callback open-note(string);
    callback delete-note(string);
    callback restore-note(string);
    callback purge-note(string);
    ScrollView {
        width: parent.width; height: parent.height;
        viewport-width: max(self.visible-width, (360px * AppAppearance.ui-scale));
        VerticalBox {
            padding: (16px * AppAppearance.ui-scale);
            spacing: (12px * AppAppearance.ui-scale);
            HorizontalBox {
                ViewTab { text: "便签"; active: !root.deleted-view; clicked => { if root.deleted-view { root.change-view(false); } } }
                ViewTab { text: "已删除"; active: root.deleted-view; clicked => { if !root.deleted-view { root.change-view(true); } } }
                Rectangle { horizontal-stretch: 1; }
                Button { min-width: (96px * AppAppearance.ui-scale); min-height: max(24px, (32px * AppAppearance.ui-scale) * AppAppearance.font-scale); text: "设置"; clicked => { root.settings(); } }
                Button { min-width: (96px * AppAppearance.ui-scale); min-height: max(24px, (32px * AppAppearance.ui-scale) * AppAppearance.font-scale); text: "+ 新建"; clicked => { root.new-note(); } }
            }
            if root.error != "": Text { font-family: AppAppearance.font-family; text: root.error; wrap: word-wrap; color: AppAppearance.danger-foreground; }
            ScrollView {
                height: max((160px * AppAppearance.ui-scale), root.height - (160px * AppAppearance.ui-scale) * AppAppearance.font-scale);
                viewport-width: self.visible-width;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    alignment: start;
                    spacing: (8px * AppAppearance.ui-scale);
                    for card in root.cards: Rectangle {
                        min-height: (root.deleted-view ? (164px * AppAppearance.ui-scale) : (136px * AppAppearance.ui-scale)) * max(1, AppAppearance.font-scale);
                        vertical-stretch: 0;
                        background: AppAppearance.note-color(card.theme-id);
                        border-radius: (10px * AppAppearance.ui-scale);
                        HorizontalLayout {
                            padding: (10px * AppAppearance.ui-scale); spacing: (12px * AppAppearance.ui-scale);
                            Rectangle {
                                horizontal-stretch: 1;
                                Text {
                                    width: parent.width; height: parent.height;
                                    font-family: AppAppearance.font-family;
                                    text: card.preview;
                                    horizontal-alignment: left; vertical-alignment: top;
                                    wrap: word-wrap; overflow: elide;
                                    color: AppAppearance.foreground;
                                }
                                TouchArea { enabled: !root.deleted-view && !card.busy; clicked => { root.open-note(card.id); } }
                            }
                            VerticalLayout {
                                width: (160px * AppAppearance.ui-scale) * max(1, AppAppearance.font-scale); horizontal-stretch: 0; spacing: (4px * AppAppearance.ui-scale);
                                Text {
                                    font-family: AppAppearance.font-family;
                                    height: (30px * AppAppearance.ui-scale) * AppAppearance.font-scale;
                                    vertical-stretch: 0; width: parent.width;
                                    text: "创建时间\n" + card.created-at;
                                    horizontal-alignment: left; vertical-alignment: top;
                                    color: AppAppearance.muted-foreground;
                                    font-size: (11px * AppAppearance.ui-scale) * AppAppearance.font-scale;
                                }
                                Text {
                                    font-family: AppAppearance.font-family;
                                    height: (30px * AppAppearance.ui-scale) * AppAppearance.font-scale;
                                    vertical-stretch: 0; width: parent.width;
                                    text: "最后修改时间\n" + card.updated-at;
                                    horizontal-alignment: left; vertical-alignment: top;
                                    color: AppAppearance.muted-foreground;
                                    font-size: (11px * AppAppearance.ui-scale) * AppAppearance.font-scale;
                                }
                                if card.status != "": Text { font-family: AppAppearance.font-family; height: (28px * AppAppearance.ui-scale) * AppAppearance.font-scale; vertical-stretch: 0; width: parent.width; text: card.status; wrap: word-wrap; overflow: elide; horizontal-alignment: left; color: AppAppearance.muted-foreground; font-size: (11px * AppAppearance.ui-scale) * AppAppearance.font-scale; }
                                if root.deleted-view: ColoredAction { text: "恢复"; available: !card.busy; clicked => { root.restore-note(card.id); } }
                                if root.deleted-view: ColoredAction { text: "彻底删除"; destructive: true; available: !card.busy; clicked => { root.purge-note(card.id); } }
                                if !root.deleted-view: DeleteButton { available: !card.busy; clicked => { root.delete-note(card.id); } }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                    if root.cards.length == 0: Text { font-family: AppAppearance.font-family; text: root.deleted-view ? "没有已删除的便签" : "还没有便签"; color: AppAppearance.muted-foreground; }
                }
            }
        }
    }
}
